<Application x:Class="LaporanProduktivitasWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Modern Color Palette -->
        <Color x:Key="BgDarkColor">#0F172A</Color>
        <Color x:Key="CardDarkColor">#1E293B</Color>
        <Color x:Key="CardDarkHoverColor">#334155</Color>
        <Color x:Key="BrandPrimaryColor">#0284C7</Color>
        <Color x:Key="BrandSecondaryColor">#4F46E5</Color>
        <Color x:Key="EmeraldColor">#10B981</Color>
        <Color x:Key="RoseColor">#F43F5E</Color>
        <Color x:Key="AmberColor">#F59E0B</Color>
        <Color x:Key="TextLightColor">#F8FAFC</Color>
        <Color x:Key="TextMutedColor">#94A3B8</Color>
        <Color x:Key="BorderDarkColor">#334155</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
        <SolidColorBrush x:Key="CardDarkBrush" Color="{StaticResource CardDarkColor}" />
        <SolidColorBrush x:Key="CardDarkHoverBrush" Color="{StaticResource CardDarkHoverColor}" />
        <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
        <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}" />
        <SolidColorBrush x:Key="EmeraldBrush" Color="{StaticResource EmeraldColor}" />
        <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
        <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
        <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardDarkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardDarkHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource EmeraldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EmeraldBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Application.Resources>
</Application>
