<Project>
  <!-- Keep restore/build artifacts of the legacy target separate from .NET 8. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LaporanProduktivitasWPF.Win7'">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\Win7\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\Win7\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
