<Window x:Class="LaporanProduktivitasWPF.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah User Baru" Height="380" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Tambah User Baru" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtUsername" Height="36" Padding="8,0" Margin="0,0,0,12" VerticalContentAlignment="Center" />

        <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtPassword" Height="36" Padding="8,0" Margin="0,0,0,12" VerticalContentAlignment="Center" />

        <TextBlock Text="Role" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
        <ComboBox x:Name="CmbRole" Height="36" Margin="0,0,0,24" Padding="8,0" VerticalContentAlignment="Center" SelectedIndex="0">
            <ComboBoxItem Content="staff" />
            <ComboBoxItem x:Name="AdminRoleItem" Content="admin" />
            <ComboBoxItem Content="viewer" />
        </ComboBox>

        <TextBlock x:Name="TxtError" Foreground="#E11D48" FontSize="12" Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Batal" Grid.Column="0" Height="38" Background="#E2E8F0" Foreground="#334155" Click="BtnCancel_Click"/>
            <Button Content="Simpan" Grid.Column="2" Height="38" Background="#0284C7" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
        </Grid>
    </StackPanel>
</Window>
