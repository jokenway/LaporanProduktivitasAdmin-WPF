<Window x:Class="LaporanProduktivitasWPF.Views.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Profil" Height="320" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Ubah Password" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TxtInfo" Text="Username: ..." FontSize="14" Foreground="#64748B" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <TextBlock Text="Password Baru" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtPassword" Height="36" Padding="8,0" Margin="0,0,0,24" VerticalContentAlignment="Center" />

        <TextBlock x:Name="TxtError" Foreground="#E11D48" FontSize="12" Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Batal" Grid.Column="0" Height="38" Background="#E2E8F0" Foreground="#334155" Click="BtnCancel_Click"/>
            <Button Content="Simpan" Grid.Column="2" Height="38" Background="#0284C7" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
        </Grid>
    </StackPanel>
</Window>

