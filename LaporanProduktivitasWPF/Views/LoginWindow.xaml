<Window x:Class="LaporanProduktivitasWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login — Laporan Produktivitas Admin"
        Height="420" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">

            <!-- Logo + Judul -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <Border Background="#3B82F6" CornerRadius="14" Width="56" Height="56"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Laporan Produktivitas Admin"
                           FontSize="17" FontWeight="Bold" Foreground="#F1F5F9"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Masuk dengan akun Anda"
                           FontSize="12" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form -->
            <Border Background="#141E2E" CornerRadius="12" Padding="28,24"
                    BorderBrush="#1E293B" BorderThickness="1">
                <StackPanel>

                    <!-- Username -->
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold"
                               Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <TextBox x:Name="TxtUsername" Height="38" Padding="12,0"
                                 Background="#0F172A" Foreground="#F1F5F9"
                                 BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"
                                 KeyDown="OnKeyDown"/>
                    </Border>

                    <!-- Password -->
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                               Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                        <PasswordBox x:Name="TxtPassword" Height="38" Padding="12,0"
                                     Background="#0F172A" Foreground="#F1F5F9"
                                     BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"
                                     KeyDown="OnKeyDown"/>
                    </Border>

                    <!-- Error message -->
                    <TextBlock x:Name="TxtError" Text="" Foreground="#F87171"
                               FontSize="12" Margin="0,4,0,12" Visibility="Collapsed"
                               TextWrapping="Wrap"/>

                    <!-- Tombol Login -->
                    <Button x:Name="BtnLogin" Content="Masuk"
                            Height="42" FontSize="14" FontWeight="Bold"
                            Background="#3B82F6" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Text="© 2025 Laporan Produktivitas Admin" FontSize="10"
                       Foreground="#334155" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>

